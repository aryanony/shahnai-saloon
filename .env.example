# Copy these names into Vercel Project Settings -> Environment Variables.
# Never commit a real .env file with real values.

# Apps Script Web App URL (Deploy > New deployment > Web app). Ends in /exec.
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwIR-FZZVCkD_7i_rD-q-9Z8BleKQTmuEAjs__lDetkBEyA-sP4idxG_OMgakEbeD_8Sw/exec

# Must exactly match the value setup() stored in Script Properties (apps-script/Code.gs).
BOOKING_SHARED_SECRET=6dbbd4c6-3b74-441f-b0fc-3417fddd25037bdf19f4b941459a9a5e13644777bf80

# Only needed if Settings!WHATSAPP_MODE is AUTO_NOTIFY. Leave WHATSAPP_PROVIDER
# blank to stay on CLICK_TO_CHAT (no cost, no approval process, no secrets needed).
WHATSAPP_PROVIDER=
# --- provider = meta (WhatsApp Business Platform / Cloud API) ---
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
# --- provider = twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=
